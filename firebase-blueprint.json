{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing authentication metadata and user role details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "passwordHash": { "type": "string" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "companyName": { "type": "string" },
        "gstNumber": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Vendor profile containing ratings and business operation metrics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "gstNumber": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "status": { "type": "string" },
        "completedOrdersCount": { "type": "number" },
        "averageDeliveryDays": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "companyName", "email", "category"]
    },
    "RFQ": {
      "title": "RFQ",
      "description": "Sourcing request document representing a request for quote.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "deadline": { "type": "string" },
        "assignedVendors": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Supplier bids submitted in response to an RFQ.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rfqId": { "type": "string" },
        "rfqTitle": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "deliveryTimeline": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "grandTotal": { "type": "number" },
        "submittedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "rfqId", "vendorId", "grandTotal", "status"]
    },
    "ApprovalWorkflow": {
      "title": "ApprovalWorkflow",
      "description": "Workflow sequence tracking signatures and manager clearances.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "requesterName": { "type": "string" },
        "status": { "type": "string" },
        "managerRemarks": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" },
        "timeline": { "type": "array" }
      },
      "required": ["id", "targetType", "targetId", "status", "updatedAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Purchase order approved by procurement department.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "rfqId": { "type": "string" },
        "rfqTitle": { "type": "string" },
        "quotationId": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "subTotal": { "type": "number" },
        "tax": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "poNumber", "vendorId", "totalAmount"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Bill statement generated upon PO execution.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "poNumber": { "type": "string" },
        "rfqId": { "type": "string" },
        "rfqTitle": { "type": "string" },
        "quotationId": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "dueDate": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "invoiceNumber", "poNumber", "grandTotal", "status"]
    },
    "AuditActivity": {
      "title": "AuditActivity",
      "description": "Audit record logging system-wide user actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "user": { "type": "string" },
        "role": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "type", "description", "user", "date"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "Broker notification details sent to system users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Contains user registration profiles and role claims."
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Registered partners in international/domestic supplier chains."
    },
    "/rfqs/{rfqId}": {
      "schema": "RFQ",
      "description": "Active/Draft public procurement requests for quotations."
    },
    "/quotations/{quoteId}": {
      "schema": "Quotation",
      "description": "Active bids lodged by authorized vendor participants."
    },
    "/approvals/{approvalId}": {
      "schema": "ApprovalWorkflow",
      "description": "Multi-stage clearance protocols for massive purchase contracts."
    },
    "/purchaseOrders/{poId}": {
      "schema": "PurchaseOrder",
      "description": "Generated POs authorizing vendor shipping workflows."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Outstanding collections of legal bills corresponding to shipping records."
    },
    "/activities/{activityId}": {
      "schema": "AuditActivity",
      "description": "Comprehensive internal history logger for security audits."
    },
    "/notifications/{notifId}": {
      "schema": "SystemNotification",
      "description": "Dynamic web broker notification alerts feed."
    }
  }
}
