rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Shared Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---- Match Rules for Collections ----

    // 1. User Profiles
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 2. Vendors list
    match /vendors/{vendorId} {
      allow read, write: if isSignedIn();
    }

    // 3. RFQs Procurement Requests
    match /rfqs/{rfqId} {
      allow read, write: if isSignedIn();
    }

    // 4. Quotation Bids
    match /quotations/{quoteId} {
      allow read, write: if isSignedIn();
    }

    // 5. Multi-stage Approvals
    match /approvals/{approvalId} {
      allow read, write: if isSignedIn();
    }

    // 6. Purchase Orders
    match /purchaseOrders/{poId} {
      allow read, write: if isSignedIn();
    }

    // 7. Invoices Billing Accounts
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // 8. Audit logs/Activities
    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }

    // 9. System Notifications Broadcasts
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }
  }
}
